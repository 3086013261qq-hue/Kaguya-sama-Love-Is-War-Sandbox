    {"id":1,"keys":["/<status>[\\s\\S]*?当前位置:[^\\n<]*(站前KTV)[\\s\\S]*?<\\/status>/s"],"secondary_keys":[],"comment":"地点:站前KTV","content":"<地点:站前KTV>\n介绍：位于繁华商业街的一家连锁卡拉OK店。走廊两侧分布大小不一的包厢，标准包厢内有U型人造革沙发、玻璃茶几、大尺寸液晶电视、点歌机和无线麦克风，隔音良好并配有可调彩色氛围灯。\n</地点:站前KTV>","constant":false,"selective":true,"insertion_order":2,"enabled":true,"position":"after_char","use_regex":true,"extensions":{"selectiveLogic":0,"position":1,"depth":4,"role":0,"match_whole_words":true,"probability":100,"useProbability":true,"sticky":0,"cooldown":0,"delay":0,"exclude_recursion":true,"prevent_recursion":true,"delay_until_recursion":false,"group":"","group_override":false,"group_weight":100,"use_group_scoring":false,"scan_depth":2,"case_sensitive":false,"automation_id":"","vectorized":false,"display_index":1,"outlet_name":"","match_persona_description":false,"match_character_description":false,"match_character_personality":false,"match_character_depth_prompt":false,"match_scenario":false,"match_creator_notes":false,"triggers":[],"ignore_budget":false}},
    {"id":2,"keys":["/<status>[\\s\\S]*?当前位置:[^\\n<]*(老字号拉面店)[\\s\\S]*?<\\/status>/s"],"secondary_keys":[],"comment":"地点:老字号拉面店","content":"<地点:老字号拉面店>\n介绍：一家充满市井气息的传统日式拉面老店。入口设有老式点餐售票机，店内以L型木制吧台为主，吧台后是开放式厨房；高脚圆凳、调料罐、自助冰水壶、手写菜单和签名板共同构成拥挤而热闹的老店气氛。\n</地点:老字号拉面店>","constant":false,"selective":true,"insertion_order":3,"enabled":true,"position":"after_char","use_regex":true,"extensions":{"selectiveLogic":0,"position":1,"depth":4,"role":0,"match_whole_words":true,"probability":100,"useProbability":true,"sticky":0,"cooldown":0,"delay":0,"exclude_recursion":true,"prevent_recursion":true,"delay_until_recursion":false,"group":"","group_override":false,"group_weight":100,"use_group_scoring":false,"scan_depth":2,"case_sensitive":false,"automation_id":"","vectorized":false,"display_index":2,"outlet_name":"","match_persona_description":false,"match_character_description":false,"match_character_personality":false,"match_character_depth_prompt":false,"match_scenario":false,"match_creator_notes":false,"triggers":[],"ignore_budget":false}},
    {"id":3,"keys":["/<status>[\\s\\S]*?当前位置:[^\\n<]*(家庭餐厅)[\\s\\S]*?<\\/status>/s"],"secondary_keys":[],"comment":"地点:家庭餐厅","content":"<地点:家庭餐厅>\n介绍：一家常见的平价连锁餐厅。大堂整齐排列软座卡座，桌面有菜单、呼叫铃、餐巾纸和调料瓶，一角设有自助饮料吧，适合大学生聚餐、聊天和临时商量事情。\n</地点:家庭餐厅>","constant":false,"selective":true,"insertion_order":4,"enabled":true,"position":"after_char","use_regex":true,"extensions":{"selectiveLogic":0,"position":1,"depth":4,"role":0,"match_whole_words":true,"probability":100,"useProbability":true,"sticky":0,"cooldown":0,"delay":0,"exclude_recursion":true,"prevent_recursion":true,"delay_until_recursion":false,"group":"","group_override":false,"group_weight":100,"use_group_scoring":false,"scan_depth":2,"case_sensitive":false,"automation_id":"","vectorized":false,"display_index":3,"outlet_name":"","match_persona_description":false,"match_character_description":false,"match_character_personality":false,"match_character_depth_prompt":false,"match_scenario":false,"match_creator_notes":false,"triggers":[],"ignore_budget":false}},
    {"id":4,"keys":["/<status>[\\s\\S]*?当前位置:[^\\n<]*(藤原家宅邸)[\\s\\S]*?<\\/status>/s"],"secondary_keys":[],"comment":"地点:藤原家宅邸","content":"<地点:藤原家宅邸>\n介绍：位于高档住宅区的现代化大型独栋别墅。欧式客厅、三角钢琴、长餐桌、现代厨房和修剪整齐的庭院共同构成明亮温馨的生活空间，屋内还保留宠物狗的豪华狗窝和玩具。\n</地点:藤原家宅邸>","constant":false,"selective":true,"insertion_order":5,"enabled":true,"position":"after_char","use_regex":true,"extensions":{"selectiveLogic":0,"position":1,"depth":4,"role":0,"match_whole_words":true,"probability":100,"useProbability":true,"sticky":0,"cooldown":0,"delay":0,"exclude_recursion":true,"prevent_recursion":true,"delay_until_recursion":false,"group":"","group_override":false,"group_weight":100,"use_group_scoring":false,"scan_depth":2,"case_sensitive":false,"automation_id":"","vectorized":false,"display_index":4,"outlet_name":"","match_persona_description":false,"match_character_description":false,"match_character_personality":false,"match_character_depth_prompt":false,"match_scenario":false,"match_creator_notes":false,"triggers":[],"ignore_budget":false}},
    {"id":5,"keys":["/<status>[\\s\\S]*?当前位置:[^\\n<]*(白银家公寓)[\\s\\S]*?<\\/status>/s"],"secondary_keys":[],"comment":"地点:白银家公寓","content":"<地点:白银家公寓>\n介绍：位于普通住宅区的一间老旧狭小出租公寓。矮桌兼顾吃饭、学习与处理兼职安排，角落堆着课程资料、书籍、打工排班表与生活杂物；厨房简陋，旧冰箱贴满超市特价传单，铺开被褥后几乎没有多余空间。\n</地点:白银家公寓>","constant":false,"selective":true,"insertion_order":6,"enabled":true,"position":"after_char","use_regex":true,"extensions":{"selectiveLogic":0,"position":1,"depth":4,"role":0,"match_whole_words":true,"probability":100,"useProbability":true,"sticky":0,"cooldown":0,"delay":0,"exclude_recursion":true,"prevent_recursion":true,"delay_until_recursion":false,"group":"","group_override":false,"group_weight":100,"use_group_scoring":false,"scan_depth":2,"case_sensitive":false,"automation_id":"","vectorized":false,"display_index":5,"outlet_name":"","match_persona_description":false,"match_character_description":false,"match_character_personality":false,"match_character_depth_prompt":false,"match_scenario":false,"match_creator_notes":false,"triggers":[],"ignore_budget":false}},
    {"id":6,"keys":["/<status>[\\s\\S]*?当前位置:[^\\n<]*(早坂爱的秘密房间)[\\s\\S]*?<\\/status>/s"],"secondary_keys":[],"comment":"地点:早坂爱的秘密房间","content":"<地点:早坂爱的秘密房间>\n介绍：隐藏在四宫家宅邸深处的现代科技房间。多屏显示器、高性能主机、监听设备、电子仪器与安保分布图占据主要空间，旁边连接装满各类服装、假发和化妆品的大型衣帽间。\n</地点:早坂爱的秘密房间>","constant":false,"selective":true,"insertion_order":7,"enabled":true,"position":"after_char","use_regex":true,"extensions":{"selectiveLogic":0,"position":1,"depth":4,"role":0,"match_whole_words":true,"probability":100,"useProbability":true,"sticky":0,"cooldown":0,"delay":0,"exclude_recursion":true,"prevent_recursion":true,"delay_until_recursion":false,"group":"","group_override":false,"group_weight":100,"use_group_scoring":false,"scan_depth":2,"case_sensitive":false,"automation_id":"","vectorized":false,"display_index":6,"outlet_name":"","match_persona_description":false,"match_character_description":false,"match_character_personality":false,"match_character_depth_prompt":false,"match_scenario":false,"match_creator_notes":false,"triggers":[],"ignore_budget":false}},
    {"id":7,"keys":["/<status>[\\s\\S]*?当前位置:[^\\n<]*(四宫家本邸)[\\s\\S]*?<\\/status>/s"],"secondary_keys":[],"comment":"地点:四宫家本邸","content":"<地点:四宫家本邸>\n介绍：占地广阔的豪华庄园，由高墙、安保系统与守卫保护。建筑融合传统日式宅邸与西式洋房，庄园包含大型日式庭院、人工湖、树林与佣人附属建筑；辉夜的私人房间宽敞且装潢考究。\n</地点:四宫家本邸>","constant":false,"selective":true,"insertion_order":8,"enabled":true,"position":"after_char","use_regex":true,"extensions":{"selectiveLogic":0,"position":1,"depth":4,"role":0,"match_whole_words":true,"probability":100,"useProbability":true,"sticky":0,"cooldown":0,"delay":0,"exclude_recursion":true,"prevent_recursion":true,"delay_until_recursion":false,"group":"","group_override":false,"group_weight":100,"use_group_scoring":false,"scan_depth":2,"case_sensitive":false,"automation_id":"","vectorized":false,"display_index":7,"outlet_name":"","match_persona_description":false,"match_character_description":false,"match_character_personality":false,"match_character_depth_prompt":false,"match_scenario":false,"match_creator_notes":false,"triggers":[],"ignore_budget":false}},
    {"id":8,"keys":["/<status>[\\s\\S]*?当前位置:[^\\n<]*(秀知院大学·桌游研究会活动室)[\\s\\S]*?<\\/status>/s"],"secondary_keys":[],"comment":"地点:秀知院大学·桌游研究会活动室","content":"<地点:秀知院大学·桌游研究会活动室>\n介绍：位于秀知院大学学生组织活动大楼的一间研究会活动室。中央拼着可移动桌，散落骰子、卡牌、跑团地图和人物卡；置物架堆满桌游、规则书与自制奇葩道具，白板上常留复杂记分表和概率计算。\n</地点:秀知院大学·桌游研究会活动室>","constant":false,"selective":true,"insertion_order":9,"enabled":true,"position":"after_char","use_regex":true,"extensions":{"selectiveLogic":0,"position":1,"depth":4,"role":0,"match_whole_words":true,"probability":100,"useProbability":true,"sticky":0,"cooldown":0,"delay":0,"exclude_recursion":true,"prevent_recursion":true,"delay_until_recursion":false,"group":"","group_override":false,"group_weight":100,"use_group_scoring":false,"scan_depth":2,"case_sensitive":false,"automation_id":"","vectorized":false,"display_index":8,"outlet_name":"","match_persona_description":false,"match_character_description":false,"match_character_personality":false,"match_character_depth_prompt":false,"match_scenario":false,"match_creator_notes":false,"triggers":[],"ignore_budget":false}},
    {"id":9,"keys":["/<status>[\\s\\S]*?当前位置:[^\\n<]*(秀知院大学·天台)[\\s\\S]*?<\\/status>/s"],"secondary_keys":[],"comment":"地点:秀知院大学·天台","content":"<地点:秀知院大学·天台>\n介绍：位于秀知院大学主教学楼顶部的露天区域。四周有高金属防护网，地面铺灰色防水涂层，并分布空调外机、通风管道和少量长椅。边缘可俯瞰运动场、林荫道、学部建筑与东京城市景观，平日学生不多，适合观星、独处与秘密谈话。\n</地点:秀知院大学·天台>","constant":false,"selective":true,"insertion_order":10,"enabled":true,"position":"after_char","use_regex":true,"extensions":{"selectiveLogic":0,"position":1,"depth":4,"role":0,"match_whole_words":true,"probability":100,"useProbability":true,"sticky":0,"cooldown":0,"delay":0,"exclude_recursion":true,"prevent_recursion":true,"delay_until_recursion":false,"group":"","group_override":false,"group_weight":100,"use_group_scoring":false,"scan_depth":2,"case_sensitive":false,"automation_id":"","vectorized":false,"display_index":9,"outlet_name":"","match_persona_description":false,"match_character_description":false,"match_character_personality":false,"match_character_depth_prompt":false,"match_scenario":false,"match_creator_notes":false,"triggers":[],"ignore_budget":false}},
    {"id":10,"keys":["/<status>[\\s\\S]*?当前位置:[^\\n<]*(秀知院大学·学生会室)[\\s\\S]*?<\\/status>/s"],"secondary_keys":[],"comment":"地点:秀知院大学·学生会室","content":"<地点:秀知院大学·学生会室>\n介绍：位于秀知院大学行政与学生自治区域高层的一间宽敞房间。中央摆有真皮沙发、实木茶几和精致茶具；靠窗是学生会长办公桌，墙边书柜保存预算、社团与研究会申请、活动企划和会议记录。整体延续秀知院名门大学的古典与讲究，是学生会日常与恋爱头脑战最常发生的中心场所。\n</地点:秀知院大学·学生会室>","constant":false,"selective":true,"insertion_order":11,"enabled":true,"position":"after_char","use_regex":true,"extensions":{"selectiveLogic":0,"position":1,"depth":4,"role":0,"match_whole_words":true,"probability":100,"useProbability":true,"sticky":0,"cooldown":0,"delay":0,"exclude_recursion":true,"prevent_recursion":true,"delay_until_recursion":false,"group":"","group_override":false,"group_weight":100,"use_group_scoring":false,"scan_depth":2,"case_sensitive":false,"automation_id":"","vectorized":false,"display_index":10,"outlet_name":"","match_persona_description":false,"match_character_description":false,"match_character_personality":false,"match_character_depth_prompt":false,"match_scenario":false,"match_creator_notes":false,"triggers":[],"ignore_budget":false}},
    {"id":11,"keys":["/<status>[\\s\\S]*?当前位置:[^\\n<]*(秀知院大学)[\\s\\S]*?<\\/status>/s"],"secondary_keys":[],"comment":"地点:秀知院大学","content":"<地点:秀知院大学>\n介绍：位于东京都内、占地广阔的顶级私立综合大学。正门与林荫大道通往校园腹地，古典欧式主教学楼和钟楼仍是视觉中心；周边分布各学部教学楼、研究设施、图书馆、学生组织活动大楼、室内体育馆和旧校舍。室外有标准运动场、网球场与西式中庭；楼内设置学生储物柜、公告区和公共学习空间。这里既保留传统精英教育，也拥有完整的现代大学课程、研究、社团与学生自治生活。\n</地点:秀知院大学>","constant":false,"selective":true,"insertion_order":12,"enabled":true,"position":"after_char","use_regex":true,"extensions":{"selectiveLogic":0,"position":1,"depth":4,"role":0,"match_whole_words":true,"probability":100,"useProbability":true,"sticky":0,"cooldown":0,"delay":0,"exclude_recursion":true,"prevent_recursion":true,"delay_until_recursion":false,"group":"","group_override":false,"group_weight":100,"use_group_scoring":false,"scan_depth":2,"case_sensitive":false,"automation_id":"","vectorized":false,"display_index":11,"outlet_name":"","match_persona_description":false,"match_character_description":false,"match_character_personality":false,"match_character_depth_prompt":false,"match_scenario":false,"match_creator_notes":false,"triggers":[],"ignore_budget":false}},
